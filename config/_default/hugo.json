{
    "baseURL": "https://rico00121.github.io/blog",
    "defaultContentLanguage": "en",
    "theme": "anatole",
    "markup": {
        "goldmark": {
            "extensions": {
                "passthrough": {
                    "enable": true,
                    "delimiters": {
                        "block": [["\\[", "\\]"], ["$$", "$$"]],
                        "inline": [["\\(", "\\)"]]
                    }
                }
            },
            "renderer": {
                "unsafe": true
            }
        }
    }
}
