{
    "baseURL": "https://rico00121.github.io/blog",
    "defaultContentLanguage": "en",
    "theme": "typo",
    "taxonomies": {
        "tag": "tags",
        "category": "categories"
    },
    "markup": {
        "goldmark": {
            "extensions": {
                "passthrough": {
                    "enable": true,
                    "delimiters": {
                        "block": [["\\[", "\\]"], ["$$", "$$"]],
                        "inline": [["\\(", "\\)"]]
                    }
                }
            },
            "renderer": {
                "unsafe": true
            }
        },
        "highlight": {
            "noClasses": false
        }
    }
}
